# Bot configuration; copy to .env and keep it private.
# Use KEY=value; wrap values containing $ in single quotes.
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=your_bot_username
# Comma-separated group IDs; may be empty during setup. Get the ID with /whoami.
MANAGED_CHAT_IDS=
# Optional user IDs with read access to every configured group.
# Mutations still require the corresponding Telegram group permissions.
SUPER_ADMIN_IDS=
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# info | verbose | debug (debug includes personal message content)
LOG_LEVEL=info
# Compose overrides this path with its persistent volume.
DATABASE_PATH=data/fuuki-iin.sqlite
# Replace with your deployed Pages HTTPS origin, without a path or trailing slash.
VERIFICATION_BASE_URL=https://verification.example.invalid
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
