<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.fuuki-iin.bot</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/TelegramFuukiIin/target/release/fuuki-iin-bot</string>
    <string>--env-file</string><string>/ABSOLUTE/PATH/TelegramFuukiIin/.env</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TelegramFuukiIin</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/TelegramFuukiIin/data/bot.stdout.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TelegramFuukiIin/data/bot.stderr.log</string>
  <key>Umask</key><integer>63</integer>
</dict>
</plist>
