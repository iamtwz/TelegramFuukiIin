[Unit]
Description=TelegramFuukiIin local Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fuuki-iin
Group=fuuki-iin
WorkingDirectory=/opt/fuuki-iin
ExecStart=/opt/fuuki-iin/bin/fuuki-iin-bot --env-file /opt/fuuki-iin/.env run
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fuuki-iin/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
